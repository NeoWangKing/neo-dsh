# deps
node_modules/
.pnpm-store/

# A root-level `pnpm run …` leaves a lockfile behind, but the repo root has no
# dependencies — the real one is apps/desktop/pnpm-lock.yaml. Anchor the pattern
# so it cannot swallow that one.
/pnpm-lock.yaml

# build output
apps/desktop/release/
apps/desktop/dist/
out/

# assembled resources (produced by scripts/build-resources.mjs / fetch-node.mjs)
apps/desktop/resources/node/
apps/desktop/resources/profile-web/node_modules/
apps/desktop/resources/profile-web/vendor/
apps/desktop/resources/presets/

# npm pack output
*.tgz

# never ship user state
*.credentials.yaml
.credentials.yaml
sessions/
*.log
